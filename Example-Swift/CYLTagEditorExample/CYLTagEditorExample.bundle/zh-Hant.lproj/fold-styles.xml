<?xml version="1.0" encoding="UTF-8"?>
<!-- CYLTagListView configuration (XML: elements are keys; <item> children make a list). -->
<CYLTagListView>
    <title>設定檔 XML：標題置中，底部僅文字</title>
    <titlePosition>topCenter</titlePosition>
    <selectionMode>multiple</selectionMode>
    <showsSectionHeaders>false</showsSectionHeaders>
    <defaultVisibleRows>1</defaultVisibleRows>
    <scrollEnabled>false</scrollEnabled>
    <foldControl>
        <position>bottom</position>
        <content>title</content>
    </foldControl>
    <style>
        <itemHeight>32</itemHeight>
        <interitemSpacing>10</interitemSpacing>
        <lineSpacing>10</lineSpacing>
        <sectionInsets>{8, 16, 8, 16}</sectionInsets>
        <normal>
            <cornerRadius>6</cornerRadius>
            <borderWidth>0</borderWidth>
            <backgroundColor>systemGray6</backgroundColor>
            <margin>12</margin>
        </normal>
        <selected>
            <cornerRadius>6</cornerRadius>
            <borderWidth>0</borderWidth>
            <backgroundColor>#E6F7EE</backgroundColor>
            <textColor>#07C160</textColor>
            <margin>12</margin>
        </selected>
    </style>
    <sections>
        <item>
            <title>狀態</title>
            <items>
                <item>婚禮賓客</item>
                <item>尾牙</item>
                <item>重要</item>
                <item>常聯繫</item>
                <item>待回覆</item>
                <item>不常聯繫</item>
            </items>
        </item>
        <item>
            <title>工作</title>
            <items>
                <item>同事</item>
                <item>前同事</item>
                <item>主管</item>
                <item>客戶</item>
                <item>供應商</item>
                <item>合作夥伴</item>
                <item>投資人</item>
                <item>獵頭</item>
            </items>
        </item>
    </sections>
</CYLTagListView>
