platform :ios, '15.0'
project 'CYLTagEditorExample.xcodeproj'

# Every CYLTabBarController mention means the latest commit of its feat/cross-platform-components branch (AGENTS.md);
# the same pin as Example/Podfile.
CYL_TAB_BAR = { :git => 'https://github.com/ChenYilong/CYLTabBarController.git',
                :commit => '57a527efee715f5ef5c162284b4778985463db5b' }
# CYLAnimatedItem, the shared animated icon + title component: its own pod in the same repository and commit, not
# on the trunk yet (https://github.com/ChenYilong/CYLTabBarController/blob/feat/cross-platform-components/docs/Animated-Item.md).
CYL_ANIMATED_ITEM = { :git => 'https://github.com/ChenYilong/CYLTabBarController.git',
                      :commit => '57a527efee715f5ef5c162284b4778985463db5b' }

# The core library from this repository (local path), so that changes to it show up here at once.
target 'CYLTagEditorExample' do
  use_frameworks!
  pod 'CollectionViewClassifyMenu', :path => '..'
  # The bottom tab bar, and the configuration parser the core uses for YAML, XML, TOML… files.
  pod 'CYLTabBarController', CYL_TAB_BAR
  pod 'CYLAnimatedItem', CYL_ANIMATED_ITEM

  target 'CYLTagEditorExampleTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
