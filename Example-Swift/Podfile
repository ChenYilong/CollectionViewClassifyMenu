platform :ios, '15.0'
project 'CYLTagEditorExample.xcodeproj'

# The core library from this repository (local path), so that changes to it show up here at once.
target 'CYLTagEditorExample' do
  use_frameworks!
  pod 'CollectionViewClassifyMenu', :path => '..'

  target 'CYLTagEditorExampleTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
