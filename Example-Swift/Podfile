platform :ios, '15.0'
project 'CYLTagEditorExample.xcodeproj'

# Every CYLTabBarController mention means the latest commit of its feat/cross-platform-components branch (AGENTS.md);
# the same pin as Example/Podfile.
CYL_TAB_BAR = { :git => 'https://github.com/ChenYilong/CYLTabBarController.git',
                :commit => 'de750a1aac9c9d8a5b702b2cf8e4affca8e2c613' }

# The core library from this repository (local path), so that changes to it show up here at once.
target 'CYLTagEditorExample' do
  use_frameworks!
  pod 'CollectionViewClassifyMenu', :path => '..'
  # The bottom tab bar, and the configuration parser the core uses for YAML, XML, TOML… files.
  pod 'CYLTabBarController', CYL_TAB_BAR

  target 'CYLTagEditorExampleTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
