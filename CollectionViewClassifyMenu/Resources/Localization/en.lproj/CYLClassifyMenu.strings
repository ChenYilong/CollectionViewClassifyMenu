/* CollectionViewClassifyMenu strings. Keys are stable identifiers; keep every language in sync. */

/* Button that shows the folded rows of a section. */
"CYLMenuExpand" = "More";
/* Button that folds a section again. */
"CYLMenuCollapse" = "Less";
/* Title of the single-choice classify menu screen. */
"CYLMenuTitle" = "Categories";
/* Confirms the selection in the multiple-choice filter. */
"CYLFilterConfirm" = "Apply";
/* Restores the default selection of the multiple-choice filter. */
"CYLFilterReset" = "Reset";
/* The action item that creates a tag. */
"CYLMenuNewTag" = "New Tag";
/* Creates a tag with this name; %@ is the name. */
"CYLMenuNewTagNamed" = "New tag: %@";
/* Accessibility hint of the fold control: expanding shows every tag. */
"CYLMenuExpandHint" = "Shows every tag";

/* The More button of a section header (three dots), read by VoiceOver after the section title. */
"CYLMenuMoreActions" = "More";
"CYLMenuDeleteTag" = "Delete";

/* Accessibility custom actions and labels: tag reordering, long press, tags on a picture. */
/* Does what a long press does on a tag or a tag group (an accessibility custom action). */
"CYLMenuLongPress" = "Long press";
/* Moves a tag one place earlier (an accessibility custom action while reordering is on). */
"CYLMenuMoveTagEarlier" = "Move earlier";
/* Moves a tag one place later. */
"CYLMenuMoveTagLater" = "Move later";
/* Announced after a move; %ld is the new position, counted from 1. */
"CYLMenuTagMoved" = "Moved to position %ld";
/* The dot of a tag group on a picture; %@ is the list of its tags. */
"CYLImageTagGroup" = "Tag group: %@";
/* A picture with tags, when its image has no accessibilityLabel. */
"CYLImageTagPicture" = "Picture";
/* Hint of a tag on a picture in edit mode. */
"CYLImageTagTurnHint" = "Double-tap to turn it";
/* Moves a tag group up (an accessibility custom action in edit mode). */
"CYLImageTagMoveUp" = "Move up";
/* Moves a tag group down. */
"CYLImageTagMoveDown" = "Move down";
/* Moves a tag group left. */
"CYLImageTagMoveLeft" = "Move left";
/* Moves a tag group right. */
"CYLImageTagMoveRight" = "Move right";
