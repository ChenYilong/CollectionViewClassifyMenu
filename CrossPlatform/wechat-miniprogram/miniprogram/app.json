  "window": {
    "navigationBarTitleText": "CYLMenuExample",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#ffffff"
  },
  "tabBar": {
    "custom": true,
    "color": "#8E8E93",
    "selectedColor": "#007AFF",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/product/product",
        "text": "product"
      },
      {
        "pagePath": "pages/search-home/search-home",
        "text": "search-home"
      },
      {
        "pagePath": "pages/scenarios/scenarios",
        "text": "scenarios"
      },
      {
        "pagePath": "pages/styles/styles",
        "text": "styles"
      },
      {
        "pagePath": "pages/animations/animations",
        "text": "animations"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "subpackages": [
    {
      "root": "engines",
      "name": "engines",
      "pages": [
        "index/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/animations/animations": {
      "network": "all",
      "packages": [
        "engines"
      ]
    },
    "pages/styles/styles": {
      "network": "all",
      "packages": [
        "engines"
      ]
    }
  }
