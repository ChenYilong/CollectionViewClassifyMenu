<view class="cyl-animation-box {{disabled ? 'cyl-animation-disabled' : ''}}" style="width: {{size}}px; height: {{boxHeight}}px;" aria-hidden="true">
  <cyl-lottie wx:if="{{engine === 'lottie'}}" id="lottie" animation-data="{{lottieData}}" autoplay="{{false}}" loop="{{loops}}"
              speed="{{speed > 0 ? speed : 1}}" resting-frame="{{selected ? 'last' : 'first'}}"
              bind:ready="onLottieReady" bind:complete="onLottieComplete"
              style="display: block; width: {{size}}px; height: {{boxHeight}}px;" />
  <cyl-rive wx:elif="{{engine === 'rive'}}" id="rive" path="{{rivePath}}" autoplay="{{false}}" loop="{{loops}}"
            speed="{{speed > 0 ? speed : 1}}" resting-frame="{{selected ? 'last' : 'first'}}" wasm-path="{{wasmPath}}"
            style="display: block; width: {{size}}px; height: {{boxHeight}}px;" />
  <image wx:elif="{{engine === 'gif'}}" class="cyl-gif" src="{{gifSrc}}" mode="aspectFit" style="width: {{size}}px; height: {{boxHeight}}px;" />
</view>
