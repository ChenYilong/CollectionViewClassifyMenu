@import "../../styles/android-sample.wxss";

/* systemBackground; the square picture, the footnote instructions (secondary label) 12 pt below, inset 16 pt, the two
   pink buttons 12 pt below them. */
page { background: #FFFFFF; }
.page { min-height: 100vh; background: #FFFFFF; }
.info {
  display: block; margin: 12px 16px 0; font-size: 13px; line-height: 18px; color: rgba(60, 60, 67, 0.6);
  white-space: pre-wrap;
}
.buttons { display: flex; gap: 8px; margin: 12px 16px 0; }
.buttons .sample-button { flex: 1; }

/* An iOS alert: 270 pt wide, rounded 14, a 17 pt semibold title, the fields, Cancel (bold, cancel style, left) and
   OK side by side. */
.alert-dim {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 900; display: flex; align-items: center;
  justify-content: center; background: rgba(0, 0, 0, 0.2);
}
.alert { width: 270px; border-radius: 14px; background: rgba(242, 242, 242, 0.97); overflow: hidden; }
.alert-title { padding: 19px 16px 0; font-size: 17px; line-height: 22px; font-weight: 600; text-align: center; color: #000000; }
.alert-fields { padding: 14px 16px 16px; }
.alert-field {
  height: 26px; padding: 0 5px; font-size: 13px; background: #FFFFFF; border: 0.5px solid rgba(60, 60, 67, 0.29);
  border-bottom-width: 0;
}
.alert-field:first-child { border-radius: 7px 7px 0 0; }
.alert-field:last-child { border-radius: 0 0 7px 7px; border-bottom-width: 0.5px; }
.alert-placeholder { color: rgba(60, 60, 67, 0.3); }
.alert-actions { display: flex; border-top: 0.5px solid rgba(60, 60, 67, 0.29); }
.alert-action { flex: 1; height: 44px; line-height: 44px; text-align: center; font-size: 17px; color: #007AFF; }
.alert-action + .alert-action { border-left: 0.5px solid rgba(60, 60, 67, 0.29); }
.alert-cancel { font-weight: 600; }
.alert-action-hover { background: rgba(0, 0, 0, 0.08); }
