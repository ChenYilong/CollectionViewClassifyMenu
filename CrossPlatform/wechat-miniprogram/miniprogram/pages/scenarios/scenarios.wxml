<view class="ios-grouped">
  <view wx:for="{{sections}}" wx:for-item="section" wx:key="header" class="ios-section">
    <view class="ios-section-header">{{section.header}}</view>
    <view class="ios-group">
      <view wx:for="{{section.rows}}" wx:for-item="row" wx:key="key" class="ios-cell ios-cell-with-image"
            hover-class="ios-cell-hover" data-key="{{row.key}}" bindtap="open" id="scenario-{{row.key}}"
            aria-role="button" aria-label="{{row.title}}">
        <image class="ios-cell-image" src="{{row.image}}" mode="aspectFit" />
        <text class="ios-cell-text">{{row.title}}</text>
        <view class="ios-chevron" />
      </view>
    </view>
    <view class="ios-section-footer">{{section.footer}}</view>
  </view>

  <view class="ios-section">
    <view class="ios-section-header">{{database.header}}</view>
    <view class="ios-group">
      <view wx:for="{{database.tables}}" wx:key="table" class="ios-cell">
        <text class="ios-cell-text ios-cell-mono">{{item.table}}</text>
        <text class="ios-cell-detail">{{item.count}}</text>
      </view>
    </view>
    <view class="ios-section-footer">{{database.footer}}</view>
  </view>
</view>
