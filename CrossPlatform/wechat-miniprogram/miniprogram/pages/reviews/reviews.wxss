/* CYLReviewListViewController: systemBackground; the filter, the status (secondarySystemBackground, footnote,
   secondaryLabel) and a plain table of subtitle cells filling the rest. */
page { background: #FFFFFF; height: 100%; }
.page { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

/* Navigation bar with the segmented control as its title view. */
.nav { flex: none; background: rgba(249, 249, 249, 0.94); }
.nav-bar { display: flex; align-items: center; box-sizing: border-box; }
.nav-back { flex: none; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; }
.nav-back-hover { opacity: 0.4; }
.nav-back-chevron {
  width: 12px; height: 12px; margin-left: 6px; transform: rotate(45deg);
  border-left: 3px solid var(--ios-blue); border-bottom: 3px solid var(--ios-blue);
}
.segmented {
  flex: 1; min-width: 0; display: flex; height: 32px; padding: 2px; box-sizing: border-box; border-radius: 9px;
  background: rgba(118, 118, 128, 0.12);
}
.segment { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; border-radius: 7px; }
.segment-selected { background: #FFFFFF; box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12), 0 3px 1px rgba(0, 0, 0, 0.04); }
.segment-title { font-size: 13px; color: #000000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 4px; }
.segment-selected .segment-title { font-weight: 600; }

/* cyl-tag-list puts lineSpacing (10) under the last row; reviewFilterStyle's bottom inset is 6. */
.filter { flex: none; margin-bottom: -4px; }

/* The footer fold control (CYLTagListFooterView, 28 high): chevron.down, turned 180° when expanded. */
.fold { flex: none; height: 28px; display: flex; align-items: center; justify-content: center; }
.fold-chevron {
  width: 7px; height: 7px; margin-top: -4px; transform: rotate(45deg); transition: transform 0.25s;
  border-style: solid; border-width: 0 1.5px 1.5px 0;
}
.fold-chevron-up { transform: rotate(225deg); margin-top: 4px; }

.status {
  flex: none; display: flex; align-items: center; padding: 4px 12px 8px; background: #F2F2F7;
}
.status-text { flex: 1; min-width: 0; font-size: 13px; line-height: 18px; color: var(--ios-secondary-label); white-space: pre-wrap; word-break: break-all; }
.spinner {
  flex: none; width: 16px; height: 16px; margin-right: 6px; border-radius: 50%; box-sizing: border-box;
  border: 2px solid rgba(60, 60, 67, 0.18); border-top-color: rgba(60, 60, 67, 0.6);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.table { flex: 1; height: 0; position: relative; transition: opacity 0.2s; }
.table-scroll { height: 100%; }
.table-loading { opacity: 0.5; }
.empty {
  position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center;
  font-size: 17px; color: var(--ios-secondary-label);
}
.cell { position: relative; display: flex; align-items: center; padding: 11px 16px 11px 16px; }
.cell::after {
  content: ''; position: absolute; right: 0; bottom: 0; left: 58px; height: 1px; transform: scaleY(0.5);
  background: var(--ios-separator);
}
.cell-image { flex: none; width: 24px; height: 24px; margin: 0 18px 0 0; }
.cell-content { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cell-text { font-size: 17px; line-height: 22px; color: #000000; }
.cell-secondary { margin-top: 2px; font-size: 15px; line-height: 20px; color: var(--ios-secondary-label); white-space: pre-wrap; }
