<view class="cyl-tag-list" style="{{backgroundStyle}}">
  <!-- The long-press callout: a small bubble with an arrow pointing at the tag (longPressAction "callout"). -->
  <view wx:if="{{callout}}" class="cyl-callout {{callout.below ? 'cyl-callout-below' : ''}}" style="left: {{callout.left}}px; top: {{callout.top}}px;" aria-role="tooltip">
    <text class="cyl-callout-text">{{callout.text}}</text>
    <view class="cyl-callout-arrow" style="left: {{callout.arrow}}px;" />
  </view>
  <!-- Flat tags (the `tags` property and the tag methods): one section of tags, drawn with tag-model.js. -->
  <!-- Touches: mut-bind (base library 2.8.2+) on the item and on its delete / rename icons, so a touch on an icon does not
       press the tag while WeChat still makes a tap of it (catching touchstart stopped the tap: the × and the pencil did
       nothing). -->
  <block wx:if="{{flat}}">
    <view class="cyl-tc" style="{{list.rootStyle}}">
      <view wx:if="{{showsSectionHeaders}}" class="cyl-tc-header" style="{{list.headerStyle}}">
        <view wx:if="{{list.headerIndicatorStyle}}" class="cyl-tc-header-indicator" style="{{list.headerIndicatorStyle}}" />
        <text class="cyl-tc-header-title" aria-role="heading">{{sectionTitle}}</text>
        <!-- The section's clear button (iOS menuShowsClearButton(forSection:)): a 44 px tap area around the icon. -->
        <view wx:if="{{clearImage}}" class="cyl-tc-clear" id="CYLTagListClearButton" bindtap="onClearTap"
              aria-role="button" aria-label="{{clearLabel}}">
          <image class="cyl-tc-clear-image" src="{{clearImage}}" mode="aspectFit" style="{{clearStyle}}" aria-hidden="true" />
        </view>
      </view>
      <view class="cyl-tc-body" style="{{list.bodyStyle}}">
        <view class="cyl-tc-items" style="{{list.itemsStyle}}">
          <view wx:for="{{items}}" wx:key="key" id="cyl-item-{{item.listKey}}"
                class="cyl-tc-item {{item.enabled ? '' : 'cyl-tc-disabled'}} {{item.hidden ? 'cyl-tc-hidden' : ''}}" style="{{item.style}}"
                data-index="{{index}}" bindtap="onTap" bindlongpress="onItemLongPress"
                mut-bind:touchstart="onTouchStart" bindtouchmove="{{allowsSmearSelection || scrollLocked ? '' : 'onTouchMove'}}"
                catchtouchmove="{{allowsSmearSelection || scrollLocked ? 'onTouchMove' : ''}}" bindtouchend="onTouchEnd"
                bindtouchcancel="onTouchCancel"
                aria-role="button" aria-label="{{item.accessibilityLabel}}" aria-selected="{{item.selected}}"
                aria-disabled="{{!item.enabled}}">
            <view wx:for="{{ripples['k' + item.key]}}" wx:for-item="ripple" wx:key="id" class="cyl-tc-ripple" style="{{ripple.style}}" />
            <block wx:if="{{item.deleteFirst}}">
              <view class="cyl-tc-delete cyl-tc-delete-leading" style="{{item.deleteIndicator.style}}" data-index="{{index}}"
                    catchtap="onDelete" mut-bind:touchstart="noop" catchlongpress="noop" aria-role="button" aria-label="{{deleteLabel}}">
                <view wx:if="{{item.deleteIndicator.cross}}" class="cyl-tc-cross" style="{{item.deleteIndicator.boxStyle}}">
                  <view class="cyl-tc-cross-line cyl-tc-cross-a" style="{{item.deleteIndicator.lineStyle}}" />
                  <view class="cyl-tc-cross-line cyl-tc-cross-b" style="{{item.deleteIndicator.lineStyle}}" />
                </view>
                <view wx:elif="{{item.deleteIndicator.image}}" class="cyl-tc-delete-image-box" style="{{item.deleteIndicator.boxStyle}}">
                  <image class="cyl-tc-delete-image" src="{{item.deleteIndicator.image}}" mode="aspectFit" style="{{item.deleteIndicator.imageStyle}}" aria-hidden="true" />
                </view>
                <text wx:else class="cyl-tc-delete-text" style="{{item.deleteIndicator.boxStyle}}">{{item.deleteIndicator.text}}</text>
              </view>
            </block>
            <image wx:if="{{item.icon.image}}" class="cyl-tc-icon" src="{{item.icon.image}}" mode="{{item.icon.mode}}"
                   style="{{item.icon.style}}" aria-hidden="true" />
            <view wx:elif="{{item.icon.badge}}" class="cyl-tc-badge" style="{{item.icon.style}}" aria-hidden="true">{{item.icon.badge}}</view>
            <text wx:if="{{item.hasTitle && item.renamesOnTitleTap}}" class="cyl-tc-title" id="CYLTagListRenameTitle-{{index}}"
                  style="{{item.titleStyle}}" data-index="{{index}}" catchtap="onRename">{{item.title}}</text>
            <text wx:elif="{{item.hasTitle}}" class="cyl-tc-title" style="{{item.titleStyle}}">{{item.title}}</text>
            <!-- A renamable tag while editing: the edit icon then the cross (iOS editingIndicatorsView). -->
            <block wx:if="{{item.editingIcons}}">
              <view class="cyl-tc-edit-icon" id="CYLTagListRenameButton-{{index}}" style="{{item.editingIcons.renameStyle}}"
                    data-index="{{index}}" catchtap="onRename" mut-bind:touchstart="noop" catchlongpress="noop"
                    aria-role="button" aria-label="{{renameLabel}}">
                <image src="{{item.editingIcons.renameImage}}" mode="aspectFit" style="{{item.editingIcons.iconStyle}}" aria-hidden="true" />
              </view>
              <view class="cyl-tc-edit-icon" id="CYLTagListDeleteButton-{{index}}" style="{{item.editingIcons.deleteStyle}}"
                    data-index="{{index}}" catchtap="onDelete" mut-bind:touchstart="noop" catchlongpress="noop"
                    aria-role="button" aria-label="{{deleteLabel}}">
                <image src="{{item.editingIcons.deleteImage}}" mode="aspectFit" style="{{item.editingIcons.iconStyle}}" aria-hidden="true" />
              </view>
            </block>
            <view wx:if="{{item.deleteIndicator && !item.deleteFirst}}" class="cyl-tc-delete" style="{{item.deleteIndicator.style}}"
                  data-index="{{index}}" catchtap="onDelete" mut-bind:touchstart="noop" catchlongpress="noop"
                  aria-role="button" aria-label="{{deleteLabel}}">
              <view wx:if="{{item.deleteIndicator.cross}}" class="cyl-tc-cross" style="{{item.deleteIndicator.boxStyle}}">
                <view class="cyl-tc-cross-line cyl-tc-cross-a" style="{{item.deleteIndicator.lineStyle}}" />
                <view class="cyl-tc-cross-line cyl-tc-cross-b" style="{{item.deleteIndicator.lineStyle}}" />
              </view>
              <view wx:elif="{{item.deleteIndicator.image}}" class="cyl-tc-delete-image-box" style="{{item.deleteIndicator.boxStyle}}">
                <image class="cyl-tc-delete-image" src="{{item.deleteIndicator.image}}" mode="aspectFit" style="{{item.deleteIndicator.imageStyle}}" aria-hidden="true" />
              </view>
              <text wx:else class="cyl-tc-delete-text" style="{{item.deleteIndicator.boxStyle}}">{{item.deleteIndicator.text}}</text>
            </view>
          </view>
          <view wx:if="{{canFold}}" class="cyl-tc-item cyl-tc-fold" id="CYLTagListFoldControl" style="{{foldStyle}}"
                bindtap="onFoldTap" aria-role="button" aria-label="{{sectionTitle}} {{foldTitle}}">
            <text wx:if="{{tagsFoldContent !== 'icon'}}">{{foldTitle}}</text>
            <image wx:if="{{tagsFoldContent !== 'title'}}" class="cyl-tc-fold-arrow {{expanded ? 'cyl-tc-up' : ''}} {{tagsFoldContent !== 'icon' ? 'cyl-tc-fold-arrow-after' : ''}}"
                   src="{{foldChevron}}" mode="aspectFit" style="{{foldChevronStyle}}" aria-hidden="true" />
          </view>
        </view>
        <!-- The fold control as the last tag (iOS CYLMenuFoldControl tail); a hidden copy measures its width. -->
        <view wx:if="{{measuringFold || canFold}}" class="cyl-tc-fold-sizer" id="CYLTagListFoldSizer" style="{{foldStyle}}" aria-hidden="true">
          <text wx:if="{{tagsFoldContent !== 'icon'}}">{{foldTitle}}</text>
          <image wx:if="{{tagsFoldContent !== 'title'}}" class="cyl-tc-fold-arrow {{tagsFoldContent !== 'icon' ? 'cyl-tc-fold-arrow-after' : ''}}"
                 src="{{foldChevron}}" mode="aspectFit" style="{{foldChevronStyle}}" />
        </view>
        <!-- CYLTagListAddItemView while editing: a name field and an Add button below the tags. -->
        <view wx:if="{{showsAddItem}}" class="cyl-tc-add">
          <input class="cyl-tc-add-field" id="CYLTagListAddItemField" value="{{addText}}" placeholder="{{addPlaceholder}}"
                 aria-label="{{addPlaceholder}}" confirm-type="done" bindinput="onAddInput" bindconfirm="onAddSubmit" />
          <view class="cyl-tc-add-button {{addText ? '' : 'cyl-tc-add-disabled'}}" id="CYLTagListAddItemButton"
                aria-role="button" aria-label="{{addTitle}}" aria-disabled="{{!addText}}" bindtap="onAddSubmit">{{addTitle}}</view>
        </view>
      </view>
    </view>
  </block>
  <view wx:for="{{sections}}" wx:for-item="section" wx:key="index" class="cyl-section" style="{{section.backgroundStyle}}">
    <view wx:if="{{section.showsHeader || (section.canFold && foldPosition === 'headerTrailing')}}" class="cyl-header" style="{{section.headerStyle}}">
      <text class="cyl-header-title">{{section.showsHeader ? section.title : ''}}</text>
      <view wx:if="{{section.canFold && foldPosition === 'headerTrailing'}}" class="cyl-fold-header" style="color: {{foldColor}};"
            data-section="{{section.index}}" bindtap="onFoldTap"
            aria-role="button" aria-label="{{section.title}} {{section.foldTitle}}">
        <text wx:if="{{foldContent !== 'icon'}}">{{section.foldTitle}}</text>
        <text wx:if="{{foldContent !== 'title'}}" class="cyl-fold-arrow {{section.expanded ? 'cyl-up' : ''}}">▾</text>
      </view>
    </view>
    <view class="cyl-section-body" style="{{section.listStyle}}">
    <view class="cyl-items" style="{{section.itemsStyle}}">
      <block wx:for="{{section.items}}" wx:key="key">
        <view wx:if="{{!item.hidden}}"
              id="cyl-item-{{item.key}}" class="cyl-item cyl-item-s{{section.index}}"
              style="{{item.cellStyle}}" data-key="{{item.key}}" bindtap="onItemTap" bindlongpress="onItemLongPress"
              aria-role="button" aria-label="{{item.subtitle ? item.title + ', ' + item.subtitle : item.title}}" aria-selected="{{item.selected}}" aria-disabled="{{!item.enabled}}">
          <view wx:if="{{item.iconKind !== 'none'}}" class="cyl-icon-slot" style="{{item.slotStyle}}">
            <text wx:if="{{item.iconKind === 'glyph'}}" class="cyl-icon cyl-glyph" style="{{item.iconStyle}}; font-size: {{item.glyphSize}}px;">{{item.glyph}}</text>
            <!-- CYLTabBarController's cyl-animated-item draws the icon: the animation through the app's engine
                 components (forwarded abstract nodes), else, and until the engine is ready, the static image. -->
            <view wx:else class="cyl-icon" style="{{item.iconStyle}}" aria-hidden="true">
              <cyl-animated-item id="anim-{{item.key}}" class="cyl-animated-icon"
                                 generic:cyl-lottie-view="cyl-lottie-view" generic:cyl-pag-view="cyl-pag-view"
                                 generic:cyl-rive-view="cyl-rive-view" generic:cyl-svga-view="cyl-svga-view"
                                 animation-url="{{item.animationUrl}}" image="{{item.iconSrc}}" icon-size="{{item.iconSize}}"
                                 speed="{{animationSpeed > 0 ? animationSpeed : item.styleSpeed}}" loop="{{animationLoops}}"
                                 selected="{{item.selected}}" enabled="{{item.iconEnabled}}"
                                 gif-first-frame="{{item.gifFirstFrame}}" gif-last-frame="{{item.gifLastFrame}}" gif-duration="{{item.gifDuration}}" autoplay="{{item.autoplay}}" />
            </view>
          </view>
          <view wx:if="{{item.spacerStyle}}" class="cyl-spacer" style="{{item.spacerStyle}}" />
          <view wx:if="{{item.showsTitle}}" class="cyl-title-box" style="{{item.titleStyle}}">
            <text class="cyl-title" style="{{item.titleTextStyle}}">{{item.title}}</text>
            <text wx:for="{{item.sizers}}" wx:for-item="sizer" wx:key="*this" class="cyl-sizer" style="{{sizer}}" aria-hidden="true">{{item.title}}</text>
          </view>
        </view>
      </block>
      <view wx:if="{{section.canFold && foldPosition === 'tail'}}" class="cyl-item cyl-fold-tail"
            style="{{section.tailStyle}}; color: {{foldColor}};" data-section="{{section.index}}" bindtap="onFoldTap"
            aria-role="button" aria-label="{{section.title}} {{section.foldTitle}}">
        <text wx:if="{{foldContent !== 'icon'}}" class="cyl-fold-title">{{section.foldTitle}}</text>
        <text wx:if="{{foldContent !== 'title'}}" class="cyl-fold-arrow {{section.expanded ? 'cyl-up' : ''}}">▾</text>
      </view>
    </view>
    </view>
    <view wx:if="{{section.canFold && foldPosition === 'footer'}}" class="cyl-fold-footer" style="color: {{foldColor}};"
          data-section="{{section.index}}" bindtap="onFoldTap"
          aria-role="button" aria-label="{{section.title}} {{section.foldTitle}}">
      <text wx:if="{{foldContent !== 'icon'}}">{{section.foldTitle}}</text>
      <view wx:if="{{foldContent !== 'title'}}" class="cyl-footer-chevron {{section.expanded ? 'cyl-footer-chevron-up' : ''}}" />
    </view>
  </view>
</view>
