/* The layout of the core's CYLTagListView and CYLTagButton (CYLMenuStyle defaults, overridable by the configuration's
   style): per section a header (headerHeight 36, gray 14 pt title, headerHorizontalInset 16), then the tags inside
   sectionInsets with interitemSpacing and lineSpacing; a tag centers its icon slot and title with imageTitleSpacing
   between them. The numbers and colors are set inline from the style (model.js tagLayout / sectionLayout). */
:host { display: block; }
/* The callout is positioned absolutely against the list (its top is relative to the list), so the list is the containing block. */
.cyl-tag-list { position: relative; }
.cyl-header { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; }
.cyl-header-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cyl-fold-header { display: flex; align-items: center; font-size: 13px; padding: 4px 0 4px 12px; }
.cyl-items { display: flex; flex-wrap: wrap; }
.cyl-item {
  display: inline-flex; align-items: center; box-sizing: border-box; border-style: solid; white-space: nowrap;
  max-width: 100%; overflow: hidden;
}
.cyl-item:active { opacity: 0.85; }
.cyl-icon-slot { position: relative; flex: none; }
.cyl-icon { position: absolute; left: 0; top: 0; display: block; }
/* cyl-animated-item lays its icon out in a box of its own (at least 44 px high, 4 px padding, transparent): its center is
   put on the icon frame's center, so the icon fills the frame and the rest of the box, clipped by the tag, draws nothing. */
.cyl-animated-icon { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); line-height: 0; }
/* An emoji stand-in takes the icon's frame like an image; its glyph is drawn inside it. */
.cyl-glyph { display: flex; align-items: center; justify-content: center; line-height: 1; overflow: visible; }
.cyl-spacer { flex: none; height: 1px; }
/* The title and, hidden, the title in the fonts of the other states: the tag is as wide as its widest state. */
.cyl-title-box { position: relative; display: inline-grid; min-width: 0; overflow: hidden; }
.cyl-title, .cyl-sizer { grid-area: 1 / 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cyl-sizer { visibility: hidden; height: 0; }
.cyl-fold-tail { justify-content: center; }
/* The long-press callout: a small bubble with an arrow, above the tag (below it when there is no room). */
.cyl-callout {
  position: absolute; z-index: 10; max-width: 240px; box-sizing: border-box; padding: 8px 12px; border-radius: 12px;
  background: #FFFFFF; color: #000000; font-size: 13px; line-height: 1.35; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  transform: translateY(calc(-100% - 8px));
}
.cyl-callout-below { transform: translateY(8px); }
.cyl-callout-text { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.cyl-callout-arrow {
  position: absolute; bottom: -6px; width: 0; height: 0; margin-left: -7px;
  border-left: 7px solid transparent; border-right: 7px solid transparent; border-top: 7px solid #FFFFFF;
}
.cyl-callout-below .cyl-callout-arrow { bottom: auto; top: -6px; border-top: 0; border-bottom: 7px solid #FFFFFF; }
@media (prefers-color-scheme: dark) {
  .cyl-callout { background: #2C2C2E; color: #FFFFFF; }
  .cyl-callout-arrow { border-top-color: #2C2C2E; }
  .cyl-callout-below .cyl-callout-arrow { border-bottom-color: #2C2C2E; }
}
/* CYLTagListFooterView: 28 pt high, chevron.down in the fold color, turned 180° when expanded. */
.cyl-fold-footer { display: flex; align-items: center; justify-content: center; height: 28px; font-size: 13px; }
.cyl-footer-chevron {
  width: 8px; height: 8px; margin-top: -5px; transform: rotate(45deg); transition: transform 0.25s;
  border-style: solid; border-color: currentColor; border-width: 0 1.6px 1.6px 0;
}
.cyl-footer-chevron-up { transform: rotate(225deg); margin-top: 5px; }
.cyl-fold-arrow { display: inline-block; margin-left: 2px; transition: transform 0.2s; }
.cyl-up { transform: rotate(180deg); }

/* Flat tags. */
/* The core's CYLTagListView with CYLTagButton tags; the numbers (insets, spacing, colors, radii) are set inline from
   the style (model.js). A tag: [delete indicator (leading)] [icon] [title] [delete indicator (trailing)], centered. */
.cyl-tc { overflow: hidden; box-sizing: border-box; font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif; }
.cyl-tc-header { display: flex; align-items: center; box-sizing: border-box; }
.cyl-tc-header-indicator { flex: none; margin-right: 8px; }
.cyl-tc-header-title { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cyl-tc-items { display: flex; flex-wrap: wrap; align-items: center; }
.cyl-tc-item {
  position: relative; overflow: hidden; display: inline-flex; align-items: center; justify-content: center;
  box-sizing: border-box; max-width: 100%; white-space: nowrap; background-size: 100% 100%;
  background-repeat: no-repeat; transition: transform 0.15s;
}
.cyl-tc-disabled { pointer-events: auto; }
.cyl-tc-title { position: relative; min-width: 0; flex: 0 1 auto; overflow: hidden; text-overflow: ellipsis; line-height: 1.1934; }
.cyl-tc-icon { position: relative; flex: none; }
.cyl-tc-badge {
  position: relative; flex: none; display: flex; align-items: center; justify-content: center; border-radius: 50%;
  color: #FFFFFF; font-weight: bold; line-height: 1;
}
.cyl-tc-delete { position: relative; flex: none; align-self: stretch; display: flex; align-items: center; }
.cyl-tc-delete-text { line-height: 1.1934; }
.cyl-tc-cross { position: relative; align-self: stretch; }
.cyl-tc-cross-line { position: absolute; left: 50%; top: 50%; }
.cyl-tc-cross-a { transform: translate(-50%, -50%) rotate(45deg); }
.cyl-tc-cross-b { transform: translate(-50%, -50%) rotate(-45deg); }
.cyl-tc-ripple {
  position: absolute; border-radius: 50%; pointer-events: none; opacity: 0;
  animation-name: cyl-tc-ripple; animation-timing-function: ease-out; animation-fill-mode: forwards;
}
@keyframes cyl-tc-ripple {
  from { transform: scale(0.05); opacity: 1; }
  to { transform: scale(1); opacity: 0; }
}
/* CYLMenuStyle.deleteIndicatorImage: the image centered in the indicator, which keeps the line height. */
.cyl-tc-delete-image-box { position: relative; align-self: stretch; display: flex; align-items: center; justify-content: center; }
.cyl-tc-delete-image { flex: none; }
/* The add control of editing mode (CYLTagListAddItemView): 44 px tall, a field and an Add button. */
.cyl-tc-add { display: flex; align-items: center; height: 44px; margin: 0 16px 10px; }
.cyl-tc-add-field { flex: 1; height: 44px; padding: 0 12px; border-radius: 8px; background-color: #F2F2F7; font-size: 17px; }
.cyl-tc-add-button { margin-left: 12px; padding: 0 12px; line-height: 44px; font-size: 17px; font-weight: 600; color: #007AFF; }
.cyl-tc-add-disabled { color: #C7C7CC; }

/* The two editing icons of a renamable tag, each a full-height tap area. */
.cyl-tc-edit-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  flex-shrink: 0;
}

/* The header's clear button at the trailing end, a 44 px tap area around the icon. */
.cyl-tc-clear {
  margin-left: auto;
  min-width: 44px;
  min-height: 44px;
  margin-top: -12px;
  margin-bottom: -12px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* Folding: hidden tags, the fold control as the last tag, and its hidden copy that measures its width. */
.cyl-tc-hidden { display: none !important; }
.cyl-tc-fold { flex-shrink: 0; }
.cyl-tc-fold-arrow { display: block; flex-shrink: 0; transition: transform 0.2s; }
.cyl-tc-fold-arrow-after { margin-left: 4px; }
.cyl-tc-up { transform: rotate(180deg); }
.cyl-tc-fold-sizer {
  position: absolute; visibility: hidden; left: 0; top: 0; display: inline-flex; align-items: center;
  box-sizing: border-box; white-space: nowrap;
}
.cyl-tc-body { position: relative; }
