<view class="cyl-tag-button" style="{{view.cellStyle}}" bindtap="onTap"
      aria-role="button" aria-label="{{view.accessibilityLabel}}" aria-selected="{{selected}}" aria-disabled="{{!enabled}}">
  <view wx:if="{{view.iconKind !== 'none'}}" class="cyl-icon-slot" style="{{view.slotStyle}}">
    <text wx:if="{{view.iconKind === 'glyph'}}" class="cyl-icon cyl-glyph" style="{{view.iconStyle}}; font-size: {{view.glyphSize}}px;">{{view.glyph}}</text>
    <!-- CYLTabBarController's cyl-animated-item draws the icon (animation through the app's engine components, else the image). -->
    <view wx:else class="cyl-icon" style="{{view.iconStyle}}" aria-hidden="true">
      <cyl-animated-item id="cyl-tag-button-animation" class="cyl-animated-icon"
                         generic:cyl-lottie-view="cyl-lottie-view" generic:cyl-pag-view="cyl-pag-view"
                         generic:cyl-rive-view="cyl-rive-view" generic:cyl-svga-view="cyl-svga-view"
                         animation-url="{{view.animationUrl}}" image="{{view.iconSrc}}" icon-size="{{view.iconSize}}"
                         speed="{{view.speed}}" loop="{{animationLoops}}" selected="{{selected}}" enabled="{{view.iconEnabled}}" />
    </view>
    <text wx:if="{{view.showsBadge}}" class="cyl-badge" style="{{view.badgeStyle}}" aria-hidden="true">{{view.badgeText}}</text>
  </view>
  <view wx:if="{{view.showsTitle}}" class="cyl-title-box" style="{{view.titleStyle}}">
    <text class="cyl-title">{{view.title}}</text>
    <text wx:if="{{view.showsBadge && view.iconKind === 'none'}}" class="cyl-badge" style="{{view.badgeStyle}}" aria-hidden="true">{{view.badgeText}}</text>
  </view>
</view>
