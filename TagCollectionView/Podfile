platform :ios, '15.0'
project 'TagCollectionView.xcodeproj'

# CollectionViewClassifyMenu depends on CYLAnimatedItem, the shared animated icon + title component: its own pod in
# CYLTabBarController's repository, not on the trunk yet, so by commit, the same as the other Podfiles' CYL_TAB_BAR
# (https://github.com/ChenYilong/CYLTabBarController/blob/feat/cross-platform-components/docs/Animated-Item.md).
CYL_ANIMATED_ITEM = { :git => 'https://github.com/ChenYilong/CYLTabBarController.git',
                      :commit => '0a63bed5aab7d65551d7ef1f0c4f1708b541ddf7' }

target 'TagCollectionView' do
  pod 'CollectionViewClassifyMenu', :path => '..'
  pod 'CYLAnimatedItem', CYL_ANIMATED_ITEM

  target 'TagCollectionViewTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
