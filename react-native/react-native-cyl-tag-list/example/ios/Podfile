# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CylTagListExample' do
  config = use_native_modules!
  # The native tag list the component wraps: CollectionViewClassifyMenu's pod.
  pod 'CollectionViewClassifyMenu', :path => '../../../..'
  # The animation engine the tags play Lottie files with (found at run time; the core does not depend on it).
  cyl_tab_bar = { :git => 'https://github.com/ChenYilong/CYLTabBarController.git',
                  :commit => 'eab038d5a19c04a77e4c97154d570c39c157f8ae' }
  pod 'CYLTabBarController', cyl_tab_bar
  # Static libraries: CYLAnimatedItem's module map must reach this target (DEFINES_MODULE in its podspec alone does not
  # make the app's Swift compiler load the module; CI b4d0e51, docs/issue-progress.md).
  pod 'CYLAnimatedItem', cyl_tab_bar.merge(:modular_headers => true)
  # The animated icon engines the example plays; the core depends on the CYLAnimatedItem pod only.
  pod 'CYLAnimatedItem/LottieObjectiveC', cyl_tab_bar
  pod 'CYLAnimatedItem/Rive', cyl_tab_bar

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
